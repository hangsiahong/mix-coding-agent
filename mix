# ─── History ─────────────────────────────────────────────────────────────────
HISTORY='[]'
if [ -f "$HIST_FILE" ] && [ -s "$HIST_FILE" ]; then
  _hist_tmp=$(cat "$HIST_FILE")
  if python3 -c 'import json,sys;json.loads(sys.stdin.read())' <<< "$_hist_tmp" 2>/dev/null; then
