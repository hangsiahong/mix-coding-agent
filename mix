# ─── Reload all extensions ──────────────────────────────────────────────────
_ext_reload() {
  # Shutdown all loaded
  for _ext in $_MIX_EXTENSIONS_LOADED; do
    if type "${_ext}_on_shutdown" >/dev/null 2>&1; then
      ${_ext}_on_shutdown 2>/dev/null || true
    fi
