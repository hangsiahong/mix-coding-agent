save_history() {
  if [ -n "${KCONSOLE_API_KEY:-}" ]; then
    printf '%s' "$HISTORY" | sed "s/$KCONSOLE_API_KEY/\[REDACTED_API_KEY\]/g" > "$HIST_FILE"
