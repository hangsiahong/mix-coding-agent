# ─── Early-exit flags (before any heavy init) ────────────────────────────────
case "${1:-}" in
  --self-test)
    # Quick health check: no network/API calls. Just verify structure.
    _st_err=""
    # python3 must exist
    command -v python3 >/dev/null 2>&1 || _st_err="${_st_err}python3 not found"$'\n'
